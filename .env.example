# Spotify Developer Dashboard application client ID (no client secret needed - PKCE public client)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# Must exactly match a Redirect URI registered on the Spotify app
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Passphrase used to derive an AES-256-GCM key (via scrypt) to encrypt tokens.json at rest.
# Use a long random value. Do not reuse across projects.
TOKEN_ENCRYPTION_KEY=change_this_to_a_long_random_secret

# Backend server port
PORT=8888

# Frontend origin, used for CORS and post-auth redirects
CLIENT_URL=http://127.0.0.1:5173

# Optional. When "true", write operations to Spotify are short-circuited (no request sent).
# Useful for testing the plan/execute flow without touching real playlists. Defaults to false.
# DRY_RUN=true
